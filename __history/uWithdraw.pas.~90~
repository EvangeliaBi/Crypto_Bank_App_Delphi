unit uWithdraw;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.Edit,
  //
  uDM, uCurrentuser;

type
  TfrmWithdraw = class(TForm)
    pnlTitleTop: TPanel;
    lblWithdraw: TLabel;
    pnlCenter: TPanel;
    lblBalance: TLabel;
    edtBalanceAmount: TEdit;
    lblAmountWithdraw: TLabel;
    edtWithdrawAmount: TEdit;
    btnWithdraw: TButton;
    procedure FormShow(Sender: TObject);
    procedure btnWithdrawClick(Sender: TObject);
  private
    { Private declarations }
    procedure LoadBalance();
  public
    { Public declarations }
  end;

var
  frmWithdraw: TfrmWithdraw;

implementation

{$R *.fmx}

procedure TfrmWithdraw.btnWithdrawClick(Sender: TObject);
var
  Amount : Double;
  //CurrentBalance : Double;
begin
 if Trim(edtWithdrawAmount.Text) = '' then
  begin
    ShowMessage('Please enter a withdrawal amount!');
    Exit;
  end;
  //
  try
    Amount := StrToFloat(edtWithdrawAmount.Text);
  Except on E : Exception do
    begin
      Showmessage('Please enter a valid numeric value!');
      Exit;
    end;
  end;
  //
 if Amount <= 0 then
  begin
    ShowMessage('Withdrawal amount must be greater than zero.');
    Exit;
  end;
  //
  try
    dmMain.FDConnection1.StartTransaction;
  //
  try
    // Update the wallet.
    dmMain.FDQueryWithdraw.Close;
    dmMain.FDQueryWithdraw.SQL.Text := 'UPDATE wallets ' +
                                  'SET balance = balance - :amount ' +
                                  'WHERE user_id = :user_id ' +
                                  'AND balance >= :amount';
    dmMain.FDQueryWithdraw.ParamByName('user_id').AsInteger := TCurrentUser.UserID;
    dmMain.FDQueryWithdraw.ParamByName('amount').AsFloat := Amount;
    dmMain.FDQueryWithdraw.ExecSQL;
    {Below we check if the wallet was updated.}
    if dmMain.FDQueryWithdraw.RowsAffected = 0 then
     begin
       dmMain.FDConnection1.Rollback;
       ShowMessage('Insufficient funds or wallet not found.');
       Exit;
     end;
    {Insert Transaction}
    dmMain.FDQueryWithdraw.Close;
    dmMain.FDQueryWithdraw.SQL.Text := 'INSERT INTO transactions ' +
                                     '(user_id, transaction_type, amount) ' +
                                     'VALUES (:user_id, :transaction_type, :amount)';
    dmMain.FDQueryWithdraw.ParamByName('user_id').AsInteger := TCurrentUser.UserID;
    dmMain.FDQueryWithdraw.ParamByName('transaction_type').AsString := 'WITHDRAW';
    dmMain.FDQueryWithdraw.ParamByName('amount').AsFloat := Amount;
    dmMain.FDQueryWithdraw.ExecSQL;
    //
    {Everything is succeeded.}
    dmMain.FDConnection1.Commit;
    ShowMessage('Withdraw was Successful!');
    edtWithdrawAmount.Text := '';
    LoadBalance;
    frmDashboard.RefreshDashboard();
  Except on E : Exception do
    begin
      dmMain.FDConnection1.Rollback;
      ShowMessage('Withdraw failed: ' + E.Message);
    end;
  end;
  //
  Except on E : Exception do
    begin
      ShowMessage('Database transaction error: ' + E.Message);
    end;
  end;
end;

procedure TfrmWithdraw.FormShow(Sender: TObject);
begin
  edtWithdrawAmount.Text := '';
  LoadBalance;
  edtWithdrawAmount.SetFocus;
end;

procedure TfrmWithdraw.LoadBalance;
begin
  dmMain.FDQueryWallet.Close;
  //
  dmMain.FDQueryWallet.SQL.Text := 'SELECT balance ' +
                                   'FROM wallets ' +
                                   'WHERE user_id = :user_id';
  dmMain.FDQueryWallet.ParamByName('user_id').AsInteger := TCurrentUser.UserID;
  dmMain.FDQueryWallet.Open;
  //
  if not dmMain.FDQueryWallet.IsEmpty then
   begin
     edtBalanceAmount.Text := '$' + FormatFloat('#,##0.00', dmMain.FDQueryWallet.FieldByName('balance').AsFloat);
   end
  else
   begin
     edtBalanceAmount.Text := '$0.00';
   end;
end;

end.
