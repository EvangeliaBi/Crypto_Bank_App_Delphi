unit uChangePassword;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.Edit,
  //
  uDM, uCurrentUser, uPasswordUtils, uAuditLog;

type
  TfrmChangePassword = class(TForm)
    pnlTop: TPanel;
    lblTopTitle: TLabel;
    pnlCenter: TPanel;
    lblCurrentPassword: TLabel;
    edtCurrentPassword: TEdit;
    lblNewPassword: TLabel;
    edtNewPassword: TEdit;
    lblConfirmPassword: TLabel;
    edtConfirmPassword: TEdit;
    btnChangePassword: TButton;
    procedure FormShow(Sender: TObject);
    procedure btnChangePasswordClick(Sender: TObject);
  private
    { Private declarations }
    procedure ClearFields();
    //
    function ValidatePasswordInput() : Boolean;
  public
    { Public declarations }
  end;

var
  frmChangePassword: TfrmChangePassword;

implementation

{$R *.fmx}

procedure TfrmChangePassword.btnChangePasswordClick(Sender: TObject);
var
  CurrentPassword : String;
  NewPassword : String;
  ConfirmPassword : String;
  CurrentPasswordHash : String;
  NewPasswordHash : String;
begin
  if not ValidatePasswordInput then
   begin
     Exit;
   end;
  //
  CurrentPassword := edtCurrentPassword.Text;
  NewPassword := edtnewPassword.Text;
  ConfirmPassword := edtConfirmPassword.Text;
  //
  {Get the current hash password.}
  try
    dmMain.FDQueryChangePassword.Close;
    //
    dmMain.FDQueryChangePassword.SQL.Text := 'SELECT password_hash ' +
                                             'FROM users ' +
                                             'WHERE id = :user_id';
    dmMain.FDQueryChangePassword.ParamByName('user_id').AsInteger := TCurrentUser.UserID;
    dmMain.FDQueryChangePassword.Open;
    //
    if dmMain.FDQueryChangePassword.IsEmpty then
     begin
       ShowMessage('User not found!');
       Exit;
     end;
    //
    CurrentPasswordHash := dmMain.FDQueryChangePassword.FieldByName('password_hash').AsString;
    {Hash entered current password}
    if HashPassword(CurrentPassword) <> CurrentPasswordHash then
     begin
       ShowMessage('Current password is incorrect.');
       edtCurrentPassword.SetFocus;
       Exit;
     end;
    //
    {Do not allow the entry of the same password.}
    if CurrentPassword = NewPassword then
     begin
       ShowMessage('New password must be different from the current password.');
       edtNewPassword.SetFocus;
       Exit;
     end;
    //
    {Hash the new password.}
    NewPasswordHash := HashPassword(NewPassword);
    //
    {Update the password.}
    dmMain.FDQueryChangePassword.Close;
    //
    dmMain.FDQueryChangePassword.SQL.Text := 'UPDATE users ' +
                                             'SET password_hash = :password_hash ' +
                                             'WHERE id = :user_id';
  Except on E:Exception do
    begin

    end;
  end;
end;

procedure TfrmChangePassword.ClearFields;
begin
  edtCurrentPassword.Text := '';
  edtNewPassword.Text     := '';
  edtConfirmPassword.Text := '';
end;

procedure TfrmChangePassword.FormShow(Sender: TObject);
begin
  ClearFields();
  //
  edtCurrentPassword.SetFocus;
end;

function TfrmChangePassword.ValidatePasswordInput: Boolean;
var
  CurrentPassword : String;
  NewPassword : String;
  ConfirmPassword : String;
begin
  Result := False;
  //
  CurrentPassword := edtCurrentPassword.Text;
  NewPassword := edtNewPassword.Text;
  ConfirmPassword := edtConfirmPassword.Text;
  //
  {Current Password}
  if Trim(CurrentPassword) = '' then
   begin
     ShowMessage('Please enter your current password.');
     edtCurrentPassword.SetFocus;
     Exit;
   end;
  //
  {New Password}
  if Trim(Newpassword) = '' then
   begin
     ShowMessage('Please enter your new password.');
     edtnewPassword.SetFocus;
     Exit;
   end;
  //
  {Password length}
  if Length(NewPassword) < 8 then
   begin
     ShowMessage('New password must be at least 8 characters long.');
     edtNewPassword.SetFocus;
     Exit;
   end;
  //
  {Confirm Password}
  if Trim(ConfirmPassword) = '' then
   begin
     ShowMessage('Please confirm your new password.');
     edtConfirmPassword.SetFocus;
     Exit;
   end;
  //
  {Password Match}
  if NewPassword <> ConfirmPassword then
   begin
     ShowMessage('New password and confirmation do not match');
     edtConfirmPassword.SetFocus;
     Exit;
   end;
  //
  Result := true;
end;

end.
